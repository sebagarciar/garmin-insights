# Copy to .env. Only GARMIN_EMAIL is worth keeping here.
# The password is optional: leave it out and scripts/login.py will prompt for
# it once, which is the safer habit. Either way it is used a single time to
# mint a token and is never written to the database or the archive.
GARMIN_EMAIL=
GARMIN_PASSWORD=

# Where the token lands. Outside the repo on purpose.
GARMIN_TOKENSTORE=~/.garmin_tokens

# The window every "deviation from normal" figure is measured against.
BASELINE_WINDOW_DAYS=30

# Used to convert heart rate into training load. HR_MAX is the number that
# matters; 220 minus age is a rough start, a real max from a hard session is
# better.
HR_MAX=190
HR_REST_FALLBACK=55

# Seconds between Garmin calls. The API is unofficial; do not drop this to 0.
GARMIN_REQUEST_DELAY=1.0

# v5, the weekly summary. Nothing leaves the laptop.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
